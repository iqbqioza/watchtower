{
	// Static single page app in build/, served by Cloudflare Workers assets.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "watchtower",
	"compatibility_date": "2026-09-23",
	// Cloudflare runs `wrangler preview` for preview deployments.
	"previews": {},
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	}
}
